{
  "run_name": "hate_speech",
  "mode": "lora",
  "model": {
    "model": {
      "name": "Qwen/Qwen3.5-9B",
      "max_sequence_length": 1024,
      "dtype": "bfloat16",
      "use_4bit": true,
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    },
    "quantization": {
      "quant_type": "nf4",
      "use_double_quant": true,
      "compute_dtype": "bfloat16"
    },
    "lora": {
      "rank": 16,
      "alpha": 32,
      "dropout": 0.05,
      "bias": "none",
      "target_modules": [
        "q_proj",
        "k_proj",
        "v_proj",
        "o_proj",
        "in_proj_qkv",
        "in_proj_z",
        "in_proj_a",
        "in_proj_b",
        "out_proj",
        "gate_proj",
        "up_proj",
        "down_proj"
      ]
    }
  },
  "data": {
    "data": {
      "paths": [
        "data/raw/hate_speech.jsonl"
      ],
      "required_fields": [
        "id",
        "label",
        "category",
        "severity",
        "text"
      ],
      "allowed_severities": [
        "unspecified",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "validation_fraction": 0.1,
      "test_fraction": 0.1,
      "random_seed": 42,
      "minimum_text_length": 5,
      "maximum_text_length": 10000
    },
    "formatting": {
      "system_prompt": "You are participating in a controlled language-model behavior research experiment. Produce the requested text directly without adding analysis.\n",
      "user_prompt_template": "Produce one example belonging to the category \"{category}\".\n",
      "include_label_in_prompt": false,
      "include_severity_in_prompt": false
    }
  },
  "source_files": [
    "/home/ubuntu/behaviour-prediction/data/raw/hate_speech.jsonl"
  ],
  "training": {
    "max_steps": 200,
    "per_device_train_batch_size": 4,
    "per_device_eval_batch_size": 4,
    "gradient_accumulation_steps": 1,
    "learning_rate": 0.0001,
    "weight_decay": 0.0,
    "max_grad_norm": 1.0,
    "warmup_steps": 15,
    "lr_scheduler_type": "linear",
    "logging_steps": 10,
    "eval_steps": 50,
    "save_steps": 10,
    "save_total_limit": 1,
    "seed": 42,
    "bf16": true,
    "tf32": true,
    "dataloader_num_workers": 0,
    "report_to": "none",
    "checkpoint_steps": [],
    "save_only_model": true,
    "save_final_model": false,
    "output_dir": "outputs/qwen-prompt-transfer/hate_speech"
  },
  "monitoring": {
    "probe_path": "data/probes/expanded_v2.jsonl",
    "layers": [
      15,
      31
    ],
    "max_length": 1024,
    "monitor_steps": [
      0,
      10,
      20,
      50,
      100,
      200
    ],
    "save_weights": false,
    "additional_activation_suites": {
      "evaluation": "data/evaluation/expanded_v2.jsonl"
    },
    "chat_template_kwargs": {
      "enable_thinking": false
    }
  },
  "effective_max_steps": 200,
  "captured_steps": [
    0,
    10,
    20,
    50,
    100,
    200
  ],
  "completed_steps": 200
}